rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isDisabled', false) != true;
    }
    function customer() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isDisabled', false) != true;
    }
    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if admin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'customer') == 'customer'
        && request.resource.data.get('rewardsPoints', 0) == 0
        && request.resource.data.get('lifetimePoints', 0) == 0
        && request.resource.data.get('tier', 'Rebel Starter') == 'Rebel Starter'
        && request.resource.data.get('isDisabled', false) == false);
      allow update: if admin() || (customer() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid','displayName','email','photoURL','phone','address','city','state','zipCode','updatedAt'
        ]));
      allow delete: if admin();
    }
    match /products/{id} { allow read: if admin() || resource.data.isActive == true; allow write: if admin(); }
    match /categories/{id} { allow read: if admin() || resource.data.isActive == true; allow write: if admin(); }
    match /collections/{id} { allow read: if admin() || resource.data.isActive == true; allow write: if admin(); }
    match /global_options/{id} { allow read: if admin() || resource.data.isActive == true; allow write: if admin(); }
    match /lookbook/{id} { allow read: if admin() || resource.data.isActive == true; allow write: if admin(); }
    match /musicTracks/{id} { allow read: if admin() || resource.data.isActive == true; allow write: if admin(); }
    match /blogPosts/{id} { allow read: if admin() || resource.data.isPublished == true; allow write: if admin(); }
    match /storeSettings/{id} { allow read: if id == 'public' || admin(); allow write: if admin(); }
    match /gameRooms/{id} { allow read, update: if admin(); }
    match /orders/{id} { allow read: if admin() || (customer() && resource.data.customerId == request.auth.uid); allow write: if admin(); }
    match /contactMessages/{id} {
      allow read, update, delete: if admin();
      allow create: if request.resource.data.keys().hasOnly(['name','email','type','message','status','isArchived','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 10000
        && request.resource.data.status == 'new' && request.resource.data.isArchived == false;
    }
    match /{collection}/{id} {
      allow read, write: if admin() && collection in ['inventory','inventoryLogs','emailSubscribers','emailCampaigns','mail'];
    }
  }
}
